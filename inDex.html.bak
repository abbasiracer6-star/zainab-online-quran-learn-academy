<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Zainab Quran Learn Academy — Learn Quran online with qualified tutors.">
<title>Zainab Quran Learn Academy | Learn Quran Online</title>
<style>
:root{--gold:#c49a52;--gold2:#e0bd79;--ink:#10100f;--cream:#f8f5ee;--muted:#6d6a64;--white:#fff;--line:#e9e1d3}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,Arial,sans-serif;color:var(--ink);background:var(--white);line-height:1.6}
a{text-decoration:none;color:inherit}
.container{width:min(1140px,92%);margin:auto}
.top{background:#070707;color:#eee;font-size:14px;padding:9px 0}
.top .container{display:flex;justify-content:flex-end;gap:24px;flex-wrap:wrap}
.top a:hover{color:var(--gold2)}
header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{height:78px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:12px}
.mark{width:46px;height:46px;border:2px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:23px}
.brand b{font-family:Georgia,serif;font-size:18px;letter-spacing:.3px}
.brand span{display:block;color:var(--gold);font-size:11px;font-weight:700;letter-spacing:1.8px}
.links{display:flex;gap:28px;font-weight:600;font-size:14px}
.links a:hover{color:var(--gold)}
.navbtn{background:var(--gold);color:white;padding:11px 19px;border-radius:7px;font-weight:700}
.menu{display:none;font-size:28px}
.hero{min-height:650px;display:grid;place-items:center;text-align:center;color:white;position:relative;overflow:hidden;background:
linear-gradient(90deg,rgba(8,14,11,.9),rgba(8,14,11,.62),rgba(8,14,11,.86)),
radial-gradient(circle at 22% 45%,#806f57 0 12%,transparent 13%),
linear-gradient(135deg,#1b2923,#0b1512 55%,#493824)}
.hero:after{content:"";position:absolute;inset:0;background-image:linear-gradient(30deg,transparent 45%,rgba(255,255,255,.025) 46%,transparent 47%);background-size:38px 38px}
.hero .inner{position:relative;z-index:1;padding:70px 0}
.kicker{font-family:Georgia,serif;color:#ead7b1;font-size:24px}
.hero h1{font-family:Georgia,serif;font-size:clamp(42px,7vw,78px);line-height:1.03;margin:15px auto 20px;max-width:920px}
.hero p{max-width:720px;margin:auto;color:#eee;font-size:19px}
.actions{margin-top:32px;display:flex;justify-content:center;gap:13px;flex-wrap:wrap}
.btn{padding:14px 25px;border-radius:8px;font-weight:800;display:inline-block}
.primary{background:var(--gold);color:#fff}
.outline{border:1px solid rgba(255,255,255,.8);color:#fff}
.primary:hover{background:#aa813e}
section{padding:82px 0}
.center{text-align:center}
.eyebrow{text-transform:uppercase;letter-spacing:2px;color:var(--gold);font-weight:800;font-size:12px}
.title{font-family:Georgia,serif;font-size:clamp(34px,5vw,54px);line-height:1.1;margin:10px 0 15px}
.sub{max-width:700px;margin:auto;color:var(--muted)}
.features{background:var(--cream)}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:38px}
.card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:30px;box-shadow:0 12px 35px rgba(50,35,10,.06)}
.icon{width:52px;height:52px;border-radius:12px;background:#f4ead7;color:var(--gold);display:grid;place-items:center;font-size:25px;margin-bottom:18px}
.card h3{font-family:Georgia,serif;font-size:23px;margin-bottom:8px}
.card p{color:var(--muted)}
.courses{background:#fff}
.course{padding:0;overflow:hidden}
.course .pic{height:170px;background:linear-gradient(135deg,#29342f,#0e1714);display:grid;place-items:center;color:#dfc185;font-family:Georgia,serif;font-size:38px}
.course .body{padding:25px}
.course .body h3{font-size:21px}
.course ul{list-style:none;color:var(--muted);margin:12px 0 18px}
.course li{margin:5px 0}
.course li:before{content:"✓";color:var(--gold);font-weight:bold;margin-right:8px}
.about{background:#111;color:#fff}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.about .title{color:#fff}
.about p{color:#cfcfcf}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:28px}
.stat{border-left:2px solid var(--gold);padding-left:15px}
.stat b{font-size:25px;color:var(--gold2);display:block}
.trial{background:linear-gradient(135deg,#c49a52,#a77b39);color:#fff;text-align:center}
.trial .title{color:#fff}
.trial p{max-width:650px;margin:0 auto 25px}
.whitebtn{background:#fff;color:#8b642c}
.contact{background:var(--cream)}
.contactgrid{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-top:35px}
.contactbox{background:#fff;border:1px solid var(--line);border-radius:15px;padding:28px}
.contactbox h3{font-family:Georgia,serif;margin-bottom:12px;font-size:24px}
.contactbox p{margin:8px 0;color:var(--muted)}
.contactbox a{color:#8b642c;font-weight:700}
footer{background:#070707;color:#bbb;padding:38px 0}
footer .foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
footer strong{color:#fff}
.float{position:fixed;right:18px;bottom:20px;background:#1f9d55;color:#fff;padding:13px 18px;border-radius:50px;font-weight:800;box-shadow:0 8px 25px #0003;z-index:30}
@media(max-width:800px){
 .links,.navbtn{display:none}.menu{display:block}
 .top .container{justify-content:center;font-size:12px}
 .grid3,.about .wrap,.contactgrid{grid-template-columns:1fr}
 .hero{min-height:590px}
 .stats{grid-template-columns:1fr}
 section{padding:65px 0}
}
</style>
</head>
<body>
